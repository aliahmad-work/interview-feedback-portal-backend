generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Role {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  description String
  users       User[]
}

model Department {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobPositions JobPositions[]
}

model User {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  employeeId    String  @unique
  firstname     String
  lastname      String
  email         String  @unique
  password      String
  roleId        String  @db.ObjectId
  role          Role    @relation(fields: [roleId], references: [id])
  designation   String?
  phone         String?
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  candidates          Candidate[]
  jobPositions        JobPositions[]
  createdInterviews   Interview[]            @relation("InterviewCreator")
  interviewIds        String[]               @db.ObjectId
  interviews          Interview[]            @relation("InterviewInterviewers", fields: [interviewIds], references: [id])
  roundIds            String[]               @db.ObjectId
  rounds              InterviewRound[]       @relation("RoundInterviewers", fields: [roundIds], references: [id])
  interviewFeedbacks  InterviewFeedback[]

  @@index([roleId])
}

model Candidate {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  candidateCode   String   @unique
  firstname       String
  lastname        String
  email           String   @unique
  phone           String   @unique
  experience      String?
  currentCompany  String?
  currentPosition String?
  skills          String[]
  notes           String?
  resumeData      Bytes?
  resumeMimeType  String?
  createdBy       String   @db.ObjectId
  creator         User     @relation(fields: [createdBy], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  interviews          Interview[]
  interviewFeedbacks  InterviewFeedback[]

  @@index ([createdBy])
}

model JobPositions {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  title             String
  requiredSkills    String[]
  minimumExperience Int
  maximumExperience Int?
  description       String
  status            String    @default("open")
  departmentId      String    @db.ObjectId
  department        Department @relation(fields: [departmentId], references: [id])
  createdBy         String    @db.ObjectId
  creator           User      @relation(fields: [createdBy], references:[id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  interviews        Interview[]

  @@index([createdBy])
  @@index([departmentId])
}

model Interview {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  round             Int
  type              String?
  date              String
  startTime         DateTime
  endTime           DateTime
  status            String        @default("scheduled")
  decision          String        @default("pending")
  decisionUpdatedAt DateTime?
  decisionUpdatedBy String?       @db.ObjectId
  candidateId       String        @db.ObjectId
  candidate         Candidate     @relation(fields: [candidateId], references: [id])
  positionId        String        @db.ObjectId
  position          JobPositions  @relation(fields: [positionId], references: [id])
  createdBy         String        @db.ObjectId
  creator           User          @relation("InterviewCreator", fields: [createdBy], references: [id])
  interviewerIds    String[]      @db.ObjectId
  interviewers      User[]        @relation("InterviewInterviewers", fields: [interviewerIds], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  rounds            InterviewRound[]
  interviewFeedbacks InterviewFeedback[]

  @@index([candidateId])
  @@index([positionId])
  @@index([createdBy])
}

model InterviewRound {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  interviewId     String         @db.ObjectId
  interview       Interview      @relation(fields: [interviewId], references: [id])
  roundNumber     Int
  type            String?
  duration        Int
  date            String?
  startTime       DateTime?
  endTime         DateTime?
  status          String         @default("pending")
  decision        String         @default("pending")
  decisionUpdatedAt DateTime?
  decisionUpdatedBy String?      @db.ObjectId
  interviewerIds  String[]       @db.ObjectId
  interviewers    User[]         @relation("RoundInterviewers", fields: [interviewerIds], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  interviewFeedbacks InterviewFeedback[]

  @@index([interviewId])
}

model InterviewFeedback {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  interviewId       String    @db.ObjectId
  interview         Interview @relation(fields: [interviewId], references: [id])
  roundId           String?   @db.ObjectId
  round             InterviewRound? @relation(fields: [roundId], references: [id])
  candidateId       String    @db.ObjectId
  candidate         Candidate @relation(fields: [candidateId], references: [id])
  interviewerId     String    @db.ObjectId
  interviewer       User      @relation(fields: [interviewerId], references: [id])
  rating            Int
  recommendation    String
  positiveComments  String
  negativeComments  String
  additionalComments String
  submittedAt       DateTime  @default(now())

  @@index([interviewId])
  @@index([roundId])
  @@index([candidateId])
  @@index([interviewerId])
}
